<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
  <title><%= setting(:name) %></title>
  <%= stylesheet_link_tag "session" %>
	<%= csrf_meta_tags %>
</head>
<body>
	<% flash.each do |key, msg| %>
		<%= content_tag :div, content_tag(:p, msg), :id => key %>
	<% end %>
	
	<%= yield %>
</body>
</html>
