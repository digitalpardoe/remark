<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= setting(:name) %> Administration - <%= (yield :title).empty? ? human_name.capitalize : (yield :title) %></title>
  <%= stylesheet_link_tag "admin" %>
  <%= stylesheet_link_tag "easymde" %>
  <%= javascript_include_tag "admin" %>
  <%= csrf_meta_tags %>
</head>
<body>

<div class="container">
  <nav class="navbar navbar-expand-md navbar-light bg-light mb-3">
    <%= link_to setting(:name), root_path, :class => "navbar-brand" %>

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbar-collapse" aria-controls="navbar-collapse" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbar-collapse">
      <ul class="navbar-nav me-auto">
        <%= nav_link 'Articles', 'articles' %>
        <%= nav_link 'Pages', 'pages' %>
        <%= nav_link 'Files', 'documents' %>
        <%= nav_link 'Settings', 'settings' %>
        <%= nav_link 'Users', 'users' %>
      </ul>

      <ul class="navbar-nav">
        <li class="nav-item"><%= button_to 'Logout', user_session_path, method: :delete, class: "btn btn-link nav-link", form_class: "btn-link-inline" %></li>
      </ul>
    </div>
  </nav>

  <div class="row">
    <div class="col-md-9">
      <h1 class="pb-2 mb-3 border-bottom"><%= (yield :title).empty? ? human_name.capitalize : (yield :title) %></h1>
      <% flash.each do |key, msg| %>
	  	<%= content_tag :div, msg, :class => ["alert", "alert-#{key}"] %>
      <% end %>

      <%= yield %>
    </div>
    <div class="col-md-3">
      <div class="card">
        <div class="card-body">
          <ul class="list-group list-group-flush">
            <li class="list-group-item"><%= link_to iconify(:icon_pencil, "New Article"), new_admin_article_path %></li>
            <li class="list-group-item"><%= link_to iconify(:icon_file, "New Page"), new_admin_page_path %></li>
            <li class="list-group-item"><%= link_to iconify(:icon_upload, "Upload File"), new_admin_document_path %></li>
            <li class="list-group-item"><%= link_to iconify(:icon_user, "Password"), edit_admin_user_path(current_user.id) %></li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>
</body>
</html>
