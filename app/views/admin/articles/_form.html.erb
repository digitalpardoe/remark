<%= error_messages_for(@article) %>

<%= markitup(f, [:body, :excerpt], :toggle => 'text_filter') %>
<%= datetime(f, :published_at) %>

<script type="text/javascript">
  Remark.elementToggler(
    { "link" : ".link-post", "article" : ".article-post" },
    ".btn-group",
    function(configuration, buttons){
      if ($("#article_url").val().length > 0 || $("#article_link_article").val() == "t") {
        $(configuration["link"]).show();
      } else if ($("#article_body").val().length > 0 || $("#article_link_article").val() == "f") {
        $(configuration["article"]).show();
      } else {
        $(buttons).show();
      }
    },
    function(clickedButton){
      if (clickedButton == "link") {
        $("#article_link_article").val("t");
      } else {
        $("#article_link_article").val("f");
      }
    }
  );
</script>

<div class="btn-group">
  <button class="btn btn-secondary link">Post Link</button>
  <button class="btn btn-secondary article">Write Article</button>
</div>

<%= f.hidden_field :link_article %>

<div class="link-post article-post mb-3">
  <%= f.label :title, :class => "form-label" %>
  <%= f.text_field :title, :placeholder => "Example Title", :class => "form-control" %>
</div>

<div class="link-post mb-3">
  <%= f.label :url, :class => "form-label" %>
  <%= f.text_field :url, :placeholder => "http://example.com/", :class => "form-control" %>
</div>

<div class="link-post article-post mb-3">
  <%= f.label :composite_tags, "Tags", :class => "form-label" %>
  <%= f.text_field :composite_tags, :placeholder => "Add, Some, Tags, Here", :class => "form-control" %>

  <%= f.label :text_filter, :class => "form-label mt-2" %>
  <%= f.select :text_filter, TEXT_FILTERS.collect { |tf| [tf[:human_readable], tf[:name]] }, {:selected => f.object.text_filter ? f.object.text_filter : setting(:text_filter)}, :class => "form-select" %>
  <div class="form-text">Changing this will change the editing mode of the fields below.</div>
</div>

<div class="article-post mb-3">
  <%= f.label :body, :class => "form-label" %>
  <%= f.text_area :body, :class => "form-control" %>
</div>

<div class="link-post article-post mb-3">
  <%= f.label :excerpt, :class => "form-label" %>
  <%= f.text_area :excerpt, :class => "form-control" %>

  <%= f.label :permalink, :class => "form-label mt-2" %>
  <%= f.text_field :permalink, :placeholder => 'generated-or-fill-me-in', :class => "form-control" %>

  <%= f.label :published_at, "Published", :class => "form-label mt-2" %>
  <%= f.text_field :published_at, :value => (@article.published_at || Time.now.utc).zoned.to_s(:admin), :class => "form-control" %>
  <div class="form-text">Set a future date to delay publishing.</div>

  <div class="form-check mt-2">
    <%= f.check_box :draft, :class => "form-check-input" %>
    <%= f.label :draft, "Draft", :class => "form-check-label" %>
  </div>

  <div class="mt-3">
    <%= f.submit "Save", :class => ["btn", "btn-primary"] %>
  </div>
</div>
