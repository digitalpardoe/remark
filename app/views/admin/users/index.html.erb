<p><%= link_to 'New User', new_admin_user_path, :class => ["btn", "btn-primary"] %></p>

<table class="table table-striped table-bordered">
  <tr>
    <th>Username</th>
    <th>Email</th>
    <th></th>
    <th></th>
  </tr>
  <% for user in @users %>
    <tr>
      <td><%= user.username %></td>
      <td><%= user.email %></td>
      <td class="text-center"><%= link_to iconify(:icon_pencil, "Edit"), edit_admin_user_path(user) %></td>
      <td class="text-center"><%= button_to admin_user_path(user), method: :delete, data: { confirm: 'Are you sure?' }, class: "btn btn-link" do %><%= iconify(:icon_remove, "Delete") %><% end %></td>
    </tr>
  <% end %>
</table>
