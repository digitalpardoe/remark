<%= form_for :setting, :url => {:action => "update"}, :html => {:method => :put} do |f| %>
    <% for setting in @settings %>
      <div class="mb-3">
        <%= f.label setting.id, setting.human_readable, :class => "form-label" %>
        <%= field_for(setting, f) %>
      </div>
    <% end %>

    <div class="mt-3">
      <%= f.submit "Save", :class => ["btn", "btn-primary"] %>
    </div>
<% end %>
