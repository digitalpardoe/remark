<%= error_messages_for(@page) %>

<%= markitup(f, :body, :toggle => 'text_filter') %>
<%= datetime(f, :published_at) %>

<div class="mb-3">
  <%= f.label :title, :class => "form-label" %>
  <%= f.text_field :title, :placeholder => "Example Title", :class => "form-control" %>
</div>

<div class="mb-3">
  <%= f.label :text_filter, :class => "form-label" %>
  <%= f.select :text_filter, TEXT_FILTERS.collect { |tf| [tf[:human_readable], tf[:name]] }, {:selected => f.object.text_filter ? f.object.text_filter : setting(:text_filter)}, :class => "form-select" %>
  <div class="form-text">Changing this will change the editing mode of the field below.</div>
</div>

<div class="mb-3">
  <%= f.label :body, :class => "form-label" %>
  <%= f.text_area :body, :class => "form-control" %>
</div>

<div class="mb-3">
  <%= f.label :permalink, :class => "form-label" %>
  <%= f.text_field :permalink, :placeholder => 'generated-or-fill-me-in', :class => "form-control" %>
</div>

<div class="mb-3">
  <%= f.label :published_at, "Published", :class => "form-label" %>
  <%= f.text_field :published_at, :value => (@page.published_at || Time.now.utc).zoned.to_s(:admin), :class => "form-control" %>
  <div class="form-text">Set a future date to delay publishing.</div>
</div>

<div class="form-check mb-2">
  <%= f.check_box :draft, :class => "form-check-input" %>
  <%= f.label :draft, "Draft", :class => "form-check-label" %>
</div>
<div class="form-check mb-3">
  <%= f.check_box :hidden, :class => "form-check-input" %>
  <%= f.label :hidden, "Hidden", :class => "form-check-label" %>
</div>

<div class="mt-3">
  <%= f.submit "Save", :class => ["btn", "btn-primary"] %>
</div>
