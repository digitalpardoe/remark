<% title("New File") %>

<%= form_for(@document, :url => admin_documents_path, :html => {:multipart => true}) do |f| %>
    <%= error_messages_for(@document) %>

    <div class="mb-3">
      <%= f.label :paperclip, "File", :class => "form-label" %>
      <%= f.file_field :paperclip, :class => "form-control" %>
    </div>

    <div class="mt-3">
      <%= f.submit "Upload", :class => ["btn", "btn-primary"] %>
    </div>
<% end %>
